--- !u!114 &260291827
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_PrefabParentObject: {fileID: 0}
  m_PrefabInternal: {fileID: 0}
  m_GameObject: {fileID: 260291825}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: dca78707d1132b04a945c1a08e84eb69, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  SampleScript: "extends script;\n\n// initialize code here:\nnum u = .11, i, j, frame;\nexport
    ship s;\nbrick[] pool, bricks;\nexport brick _brick;\npool.add(_brick);\npool[0].spr.ca
    = 0;\nwhile(i < 200)\n pool.add(clone(pool[0]));\n i += 1;\nend\nfunc create_row()\n
    num rowy, c, pidx;\n c = 1; pidx = 0;\n while(c <= 31)\n  c += 1;\n  if(rand(0,
    5) < 2) continue; end\n  while(pidx < pool.count)\n   brick br = pool[pidx];\n
    \  if(br.spr.ca == 0) break; end\n   pidx += 1;\n  end\n  if(br.spr.ca == 1)\n
    \  br = clone(br);\n   pool.add(br);\n  end\n  br.x = c; br.y = rowy; br.spr.ca
    = 1;\n  br.set();\n  bricks.add(br);\n end\nend\nrowy = 31;\nwhile(rowy <= 41)\n
    create_row();\n rowy += 1;\nend\n// update is called once per frame.\nfunc update()\n
    frame += dtime;\n if(frame >= 0.7)\n  frame -= 0.7;\n  i = 0;\n  while(i < bricks.count)\n
    \  br = bricks[i];\n   br.y -= 1; br.set();\n   i += 1;\n  end\n  rowy = 41; create_row();\n
    end\nend\nfunc late_update()\n i = 0;\n while(i < s.gun.count)\n  bullet bu =
    s.gun[i];\n  i += 1;\n  if(bu.spr.ca == 0) continue; end\n  j = 0;\n  while(j
    < bricks.count)\n   br = bricks[j];\n   if(br.x == bu.x and br.y <= bu.y)\n    bu.hp
    -= 1; br.spr.ca = 0;\n    if(bu.hp <= 0) bu.spr.ca = 0; end\n    bricks.remove(j);\n
    \   break;\n   end\n   j += 1;\n  end\n end\nend"
  ScriptEditor: {fileID: 2114592188}
